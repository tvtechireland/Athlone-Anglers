# Copy this file to .env.local and fill in your Supabase project's values.
# Find these in the Supabase dashboard: Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (Project Settings > API > Secret keys). Server-only - never
# expose to the browser. Used to create committee logins from the admin UI.
SUPABASE_SERVICE_ROLE_KEY=
